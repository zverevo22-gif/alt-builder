# =====================================================================
#  Пользовательская фича брендирования use/custom-brand
#
#  Цель (config.mk) регистрирует фичу; содержимое каталога копируется
#  в профиль на стадии наполнения (profile/populate):
#    files/          ->  в корень ФС инсталлятора (копирование COPY_TREE)
#    live/install2/  ->  image-scripts.d-хуки, выполняемые внутри
#                        соответствующих chroot'ов при сборке
#
#  Наполнение (мое files/, хуки, содержимое конфигурационных файлов)
#  генерирует scripts/gen-profile.sh из config/branding.conf
#  и config/packages.conf. Этот файл не редактируйте.
# =====================================================================

use/custom-brand:
	@$(call add_feature)